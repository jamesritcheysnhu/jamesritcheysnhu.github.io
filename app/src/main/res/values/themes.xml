<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EventTracker" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/medium_blue</item>
        <item name="colorPrimaryDark">@color/dark_blue</item>

        <item name="colorAccent">@color/light_gray</item>
    </style>

    <style name="PlainButton">
        <item name="android:textSize">32sp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_width">320dp</item>
        <item name="android:layout_marginLeft">24dp</item>
        <item name="android:layout_marginRight">24dp</item>
    </style>

    <style name="DateTimePicker">
        <item name="android:textSize">32sp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:scaleX">0.8</item>
        <item name="android:scaleY">0.8</item>
        <item name="android:layout_marginLeft">-32dp</item>
        <item name="android:layout_marginRight">-32dp</item>
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="TextEntry">
        <item name="android:textSize">24sp</item>
        <item name="android:layout_marginLeft">24dp</item>
        <item name="android:layout_marginRight">24dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="Title">
        <item name="android:textSize">36sp</item>
        <item name="android:layout_margin">24dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Label">
        <item name="android:textSize">20sp</item>
        <item name="android:layout_marginLeft">24dp</item>
        <item name="android:layout_marginRight">24dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Theme.EventTracker" parent="Base.Theme.EventTracker" />
</resources>


